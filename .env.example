# PayPal REST app credentials (SANDBOX). Get them at:
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live  (keep sandbox for the hackathon)
PAYPAL_ENV=sandbox

# Optional LLM provider key. NOTE: the PayPal AI Hackathon provides NO free
# LLM credits — bring your own key (OpenAI or any provider supported by your
# chosen framework), or leave blank to run without an LLM.
OPENAI_API_KEY=

# Server port (Render injects PORT automatically)
PORT=3000
