# PayPal REST app credentials (SANDBOX). Get them at:
# https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run in dry-run mode (HTTP + policies work; no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live  (live is refused — hackathon forces dry-run; keep sandbox)
PAYPAL_ENV=sandbox

# Optional LLM provider key. NOTE: the PayPal AI Hackathon provides NO free
# LLM credits — bring your own key, or leave blank to run without an LLM.
OPENAI_API_KEY=

# Server port (Render injects PORT automatically)
PORT=3000

# --- PayGuard policy + demo auth (P0, no PayPal login required) ---
# API key for POST /payouts/propose|confirm|cancel and GET /audit.
# Judges: send header  X-API-Key: <value>
# Default when unset: payguard-demo-key (so npm start works out of the box).
PAYGUARD_API_KEY=payguard-demo-key

# Spend caps (major currency units)
PAYGUARD_PER_TX_LIMIT=500
PAYGUARD_DAILY_LIMIT=2000

# Comma-separated trusted recipients. If unset → seed Alice/Bob/Dana.
# If set to empty → empty allow-list (≠ allow-all); all payees → CONFIRM.
# Charlie is intentionally NOT in the seed (demo CONFIRM theater).
# PAYGUARD_ALLOW_LIST=alice@example.com,bob@example.com,dana@example.com
